{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for the Desk app",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:tray:default",
    "log:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load"
  ]
}
