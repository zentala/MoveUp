{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zntlDesk",
  "version": "0.1.0",
  "identifier": "io.zntl.desk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1443",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desk",
        "width": 520,
        "height": 640,
        "x": 1400,
        "y": 440,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      },
      {
        "label": "welcome",
        "title": "zntlDesk — Witaj!",
        "width": 480,
        "height": 420,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
