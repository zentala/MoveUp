{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartDesk",
  "version": "0.5.0",
  "identifier": "io.zntl.desk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1443",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Desk",
        "width": 420,
        "height": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      },
      {
        "label": "welcome",
        "title": "Smart Desk — Witaj!",
        "width": 480,
        "height": 420,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false
      },
      {
        "label": "analyst",
        "title": "Smart Desk — Analyst",
        "url": "index.html#/mockup/analyst",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png"
      }
    },
    "shortDescription": "Ergonomics tracker for sit/stand desk"
  }
}
